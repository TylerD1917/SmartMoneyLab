---
import BaseLayout from "./BaseLayout.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Comments from "../components/Comments.astro";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  ogImage?: string;
  toolType?: string;
  downloadUrl?: string;
  downloadFilename?: string;
  downloadSize?: string;
  tier?: "free" | "pro";
  license?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = "SmartMoneyLab",
  ogImage,
  toolType,
  downloadUrl,
  downloadFilename,
  downloadSize,
  tier = "free",
  license,
} = Astro.props;

const fmt = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const toolTypeLabels: Record<string, string> = {
  excel: "Foglio Excel",
  "google-sheets": "Google Sheets",
  calculator: "Calcolatore",
  dashboard: "Dashboard live",
  "reading-list": "Lista di letture",
  other: "Strumento",
};
const typeLabel = toolType ? toolTypeLabels[toolType] ?? toolTypeLabels.other : "";
---
<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article class="mx-auto max-w-3xl">
    <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-800">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">
        {typeLabel && (
          <span class="rounded-md bg-blue-900/10 px-2 py-0.5 text-blue-900 dark:bg-blue-400/10 dark:text-blue-400">
            {typeLabel}
          </span>
        )}
        {tier === "pro" && (
          <span class="rounded-md bg-amber-100 px-2 py-0.5 text-amber-900 dark:bg-amber-400/10 dark:text-amber-400">
            Pro
          </span>
        )}
        <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Agg. {fmt.format(updatedDate)}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{author}</span>
      </div>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">{description}</p>
      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-slate-200 px-2.5 py-0.5 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300">
              #{tag}
            </li>
          ))}
        </ul>
      )}
    </header>

    {/* Bottone download in evidenza, all'inizio dell'articolo */}
    {downloadUrl && (
      <aside
        class="not-prose mb-10 flex flex-col items-start gap-4 rounded-lg border border-blue-900/20 bg-blue-900/5 p-5 sm:flex-row sm:items-center sm:justify-between dark:border-blue-400/30 dark:bg-blue-400/10"
      >
        <div>
          <div class="text-sm font-semibold text-slate-900 dark:text-slate-50">
            Scarica il file
          </div>
          <div class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            {downloadFilename ?? "tracker-investimenti.xlsx"}
            {downloadSize && (
              <span class="ml-2 text-slate-400">· {downloadSize}</span>
            )}
            {tier === "free" && (
              <span class="ml-2 rounded bg-emerald-100 px-1.5 py-0.5 text-xs text-emerald-900 dark:bg-emerald-400/10 dark:text-emerald-400">
                Gratis
              </span>
            )}
          </div>
        </div>
        <a
          href={downloadUrl}
          download={downloadFilename}
          class="inline-flex items-center gap-2 rounded-md bg-blue-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-950 dark:bg-blue-400 dark:text-slate-950 dark:hover:bg-blue-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Scarica
        </a>
      </aside>
    )}

    <div class="prose prose-slate max-w-none dark:prose-invert">
      <slot />
    </div>

    {/* Bottone download replicato in fondo, post-lettura */}
    {downloadUrl && (
      <aside
        class="not-prose mt-12 flex flex-col items-start gap-3 rounded-lg border border-slate-200 bg-slate-50 p-5 sm:flex-row sm:items-center sm:justify-between dark:border-slate-700 dark:bg-slate-900/60"
      >
        <div class="text-sm text-slate-600 dark:text-slate-300">
          Pronto a usarlo? <strong class="text-slate-900 dark:text-slate-50">Scarica il file</strong>
          {downloadSize && (
            <span class="text-slate-400"> ({downloadSize})</span>
          )}
        </div>
        <a
          href={downloadUrl}
          download={downloadFilename}
          class="inline-flex items-center gap-2 rounded-md bg-blue-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-950 dark:bg-blue-400 dark:text-slate-950 dark:hover:bg-blue-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Scarica {downloadFilename ?? ""}
        </a>
      </aside>
    )}

    {license && (
      <p class="mt-4 text-xs italic text-slate-500 dark:text-slate-400">
        <strong>Licenza:</strong> {license}
      </p>
    )}

    <Disclaimer />
    <Comments />
  </article>
</BaseLayout>
