---
import BaseLayout from "./BaseLayout.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Comments from "../components/Comments.astro";
import SeoSchema from "../components/SeoSchema.astro";
import { getSeriesMeta } from "../data/series";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  ogImage?: string;
  series?: string;
  seriesOrder?: number;
  verdict?: "vince" | "parziale" | "non-vince";
  faq?: { q: string; a: string }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = "SmartMoneyLab",
  ogImage,
  series,
  seriesOrder,
  verdict,
  faq,
} = Astro.props;

const seriesMeta = getSeriesMeta(series);

// Breadcrumb: "Articoli" e' la home del blog (vedi nav in Header.astro).
// Se il post appartiene a una serie, la serie diventa il livello intermedio.
const breadcrumbs = [
  { name: "Articoli", url: "/" },
  ...(seriesMeta ? [{ name: seriesMeta.shortLabel, url: `/serie/${seriesMeta.slug}` }] : []),
  { name: title, url: Astro.url.pathname },
];

const verdictMap = {
  vince: { label: "Vince", color: "emerald" },
  parziale: { label: "Parziale", color: "amber" },
  "non-vince": { label: "Non vince", color: "rose" },
} as const;
const verdictMeta = verdict ? verdictMap[verdict] : null;

const fmt = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---
<BaseLayout title={title} description={description} ogImage={ogImage}>
  <SeoSchema
    type="BlogPosting"
    title={title}
    description={description}
    breadcrumbs={breadcrumbs}
    datePublished={pubDate}
    dateModified={updatedDate}
    author={author}
    image={ogImage}
    keywords={tags}
    faq={faq}
  />
  <article class="mx-auto max-w-3xl">
    <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-800">
      {seriesMeta && (
        <div class="mb-4">
          <a
            href={`/serie/${seriesMeta.slug}`}
            class="inline-flex items-center gap-2 rounded-full border border-blue-900/30 bg-blue-900/5 px-3 py-1 text-xs font-medium text-blue-900 hover:border-blue-900/60 dark:border-blue-400/40 dark:bg-blue-400/10 dark:text-blue-400 dark:hover:border-blue-400/70"
          >
            <span class="font-semibold uppercase tracking-wider">Serie</span>
            <span aria-hidden="true">·</span>
            <span>{seriesMeta.shortLabel}</span>
            {seriesOrder && (
              <>
                <span aria-hidden="true">·</span>
                <span class="font-mono">#{seriesOrder}</span>
              </>
            )}
          </a>
          {verdictMeta && (
            <span
              class:list={[
                "ml-2 inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider",
                verdictMeta.color === "emerald" && "bg-emerald-100 text-emerald-900 dark:bg-emerald-400/10 dark:text-emerald-400",
                verdictMeta.color === "amber" && "bg-amber-100 text-amber-900 dark:bg-amber-400/10 dark:text-amber-400",
                verdictMeta.color === "rose" && "bg-rose-100 text-rose-900 dark:bg-rose-400/10 dark:text-rose-400",
              ]}
            >
              {verdictMeta.label}
            </span>
          )}
        </div>
      )}
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">
        <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Agg. {fmt.format(updatedDate)}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{author}</span>
      </div>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">{description}</p>
      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-slate-200 px-2.5 py-0.5 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300">
              #{tag}
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose prose-slate max-w-none dark:prose-invert">
      <slot />
    </div>

    <Disclaimer />
    <Comments />
  </article>
</BaseLayout>
