---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title,
  description = "SmartMoneyLab — finanza personale e analisi quantitativa, senza hype.",
  ogImage = "/og-default.png",
  canonical,
} = Astro.props;

const siteName = "SmartMoneyLab";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="it" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="it_IT" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <!-- Tema: solo chiaro (dark mode rimossa). Le classi dark: nel codice restano inerti. -->

    <!-- Cloudflare Web Analytics (privacy-first, no cookie, no GDPR popup) -->
    <!-- Le visite del proprietario NON vengono conteggiate.
         Per escludere un dispositivo, visitare UNA volta:
           https://smartmoneylab.it/?sml_owner=1     -> esclude
           https://smartmoneylab.it/?sml_owner=0     -> torna a contare
         Funziona anche da telefono, dove non c'è la console. Il flag vive in
         localStorage, quindi è per-browser e per-origine: va ripetuto su ogni
         dispositivo e browser, e non sopravvive alle finestre in incognito né
         alla cancellazione dei dati del sito.
         Equivalente da console desktop: localStorage.setItem('sml_owner','1') -->
    <script is:inline>
      (function () {
        var KEY = 'sml_owner';
        var isOwner = false;

        // 1. il parametro nell'URL ha la precedenza e scrive il flag
        try {
          var q = new URLSearchParams(location.search).get(KEY);
          if (q === '1' || q === '0') {
            if (q === '1') localStorage.setItem(KEY, '1');
            else localStorage.removeItem(KEY);
            // conferma visibile: serve sul telefono, e la vede solo chi passa il parametro
            alert(q === '1'
              ? 'SmartMoneyLab: le visite da questo browser NON verranno più conteggiate.'
              : 'SmartMoneyLab: le visite da questo browser verranno di nuovo conteggiate.');
            // ripulisce l'URL, così il parametro non finisce in link condivisi
            if (history.replaceState) {
              var u = new URL(location.href);
              u.searchParams.delete(KEY);
              history.replaceState(null, '', u.pathname + u.search + u.hash);
            }
          }
        } catch (e) {}

        // 2. decide se caricare il beacon
        try { isOwner = localStorage.getItem(KEY) === '1'; } catch (e) {}
        if (isOwner) return;

        var b = document.createElement('script');
        b.defer = true;
        b.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        b.setAttribute('data-cf-beacon', '{"token": "e1598d3ec21f4fb79dbebb87b96983ab"}');
        document.head.appendChild(b);
      })();
    </script>
    <!-- head extra per-pagina (es. JSON-LD) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-blue-900 focus:px-3 focus:py-2 focus:text-white">Salta al contenuto</a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-5xl px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
