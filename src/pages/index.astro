---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSeriesMeta } from "../data/series";
import { CATEGORIES, CATEGORY_ORDER, getCategoryMeta } from "../data/categories";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "short",
  year: "numeric",
});

const verdictMap = {
  vince: { label: "Vince", color: "emerald" },
  parziale: { label: "Parziale", color: "amber" },
  "non-vince": { label: "Non vince", color: "rose" },
} as const;

// Chip di filtro: "Tutti" attivo di default (server-render). Le classi attive e
// inattive sono elencate qui come stringhe letterali così che Tailwind le
// generi; lo script client le scambia al clic.
const chipBase =
  "cat-chip inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium transition-colors";
const chipActive =
  "border-blue-900 bg-blue-900 text-white dark:border-blue-400 dark:bg-blue-400 dark:text-slate-900";
const chipInactive =
  "border-slate-300 text-slate-600 hover:border-blue-900 hover:text-blue-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-400";

// Solo le categorie che hanno almeno un articolo pubblicato.
const usedCategories = CATEGORY_ORDER.filter((slug) =>
  posts.some((p) => p.data.category === slug)
);
---
<BaseLayout
  title="SmartMoneyLab"
  description="Finanza personale e analisi quantitativa. Articoli, simulazioni e strumenti interattivi per investitori retail con conoscenze intermedie."
>
  <section class="mb-14 mt-2">
    <h1 class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-5xl">
      SmartMoneyLab
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      Finanza personale e analisi quantitativa.
    </p>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Articoli divulgativi, simulazioni riproducibili e strumenti interattivi per
      investitori retail con conoscenze intermedie. Niente clickbait, niente promesse
      di rendimento — solo dati e fonti primarie.
    </p>
  </section>

  <section aria-labelledby="latest-posts">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 id="latest-posts" class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Ultimi articoli
      </h2>
      <span id="post-count" class="text-xs text-slate-400 dark:text-slate-500">
        {posts.length} articoli
      </span>
    </div>

    {usedCategories.length > 0 && (
      <div
        class="mb-6 flex flex-wrap gap-2"
        role="group"
        aria-label="Filtra per categoria"
      >
        <a href="/" data-cat-chip="" class:list={[chipBase, chipActive]}>Tutti</a>
        {usedCategories.map((slug) => (
          <a
            href={`/categoria/${slug}`}
            data-cat-chip={slug}
            class:list={[chipBase, chipInactive]}
          >
            {CATEGORIES[slug].shortLabel}
          </a>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <p class="text-slate-500 dark:text-slate-400">Nessun articolo pubblicato. Stay tuned.</p>
    ) : (
      <ul id="post-list" class="divide-y divide-slate-200 dark:divide-slate-800">
        {posts.map((post) => {
          const seriesMeta = getSeriesMeta(post.data.series);
          const catMeta = getCategoryMeta(post.data.category);
          const v = post.data.verdict ? verdictMap[post.data.verdict] : null;
          return (
            <li class="py-5" data-category-item data-category={post.data.category ?? ""}>
              <a href={`/posts/${post.slug}`} class="group block">
                <div class="flex flex-wrap items-baseline gap-3 text-xs text-slate-500 dark:text-slate-400">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {fmt.format(post.data.pubDate)}
                  </time>
                  {catMeta && (
                    <span class="rounded-md bg-slate-100 px-1.5 py-0.5 font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                      {catMeta.shortLabel}
                    </span>
                  )}
                  {seriesMeta && (
                    <span class="rounded-md bg-blue-900/10 px-1.5 py-0.5 font-medium text-blue-900 dark:bg-blue-400/10 dark:text-blue-400">
                      Serie · {seriesMeta.shortLabel}
                    </span>
                  )}
                  {v && (
                    <span
                      class:list={[
                        "rounded-md px-1.5 py-0.5 font-semibold uppercase tracking-wider",
                        v.color === "emerald" && "bg-emerald-100 text-emerald-900 dark:bg-emerald-400/10 dark:text-emerald-400",
                        v.color === "amber" && "bg-amber-100 text-amber-900 dark:bg-amber-400/10 dark:text-amber-400",
                        v.color === "rose" && "bg-rose-100 text-rose-900 dark:bg-rose-400/10 dark:text-rose-400",
                      ]}
                    >
                      {v.label}
                    </span>
                  )}
                  {post.data.tags?.slice(0, 2).map((t) => (
                    <span>#{t}</span>
                  ))}
                </div>
                <h3 class="mt-1 text-xl font-medium text-slate-900 group-hover:text-blue-900 dark:text-slate-50 dark:group-hover:text-blue-400">
                  {post.data.title}
                </h3>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                  {post.data.description}
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <p id="empty-filter" hidden class="py-8 text-slate-500 dark:text-slate-400">
      Nessun articolo in questa categoria.
    </p>
  </section>
</BaseLayout>

<script>
  // Filtro categorie client-side, progressivo: i chip sono <a> verso le pagine
  // /categoria/<slug> (funzionano anche senza JS); qui li trasformiamo in filtro
  // in-place sulla stessa home, sincronizzato con ?cat= nell'URL.
  const VALID = ["strategie", "approfondimenti", "finanza-personale"];
  const ACTIVE =
    "border-blue-900 bg-blue-900 text-white dark:border-blue-400 dark:bg-blue-400 dark:text-slate-900".split(" ");
  const INACTIVE =
    "border-slate-300 text-slate-600 hover:border-blue-900 hover:text-blue-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-400".split(" ");

  const chips = Array.from(document.querySelectorAll("[data-cat-chip]"));
  const items = Array.from(document.querySelectorAll("[data-category-item]"));
  const countEl = document.getElementById("post-count");
  const emptyEl = document.getElementById("empty-filter");

  function catFromUrl() {
    const p = new URLSearchParams(location.search).get("cat") || "";
    return VALID.includes(p) ? p : "";
  }

  function apply(cat) {
    let n = 0;
    items.forEach((li) => {
      const match = !cat || li.dataset.category === cat;
      li.hidden = !match;
      if (match) n++;
    });
    chips.forEach((c) => {
      const active = (c.dataset.catChip || "") === (cat || "");
      c.classList.remove(...(active ? INACTIVE : ACTIVE));
      c.classList.add(...(active ? ACTIVE : INACTIVE));
      if (active) c.setAttribute("aria-current", "true");
      else c.removeAttribute("aria-current");
    });
    if (countEl) countEl.textContent = n + " " + (n === 1 ? "articolo" : "articoli");
    if (emptyEl) emptyEl.hidden = n !== 0;
  }

  chips.forEach((c) => {
    c.addEventListener("click", (e) => {
      e.preventDefault();
      const cat = c.dataset.catChip || "";
      apply(cat);
      history.pushState({ cat }, "", cat ? "/?cat=" + cat : "/");
    });
  });

  window.addEventListener("popstate", () => apply(catFromUrl()));
  apply(catFromUrl());
</script>
