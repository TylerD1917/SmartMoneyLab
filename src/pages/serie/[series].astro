---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SERIES, getSeriesMeta } from "../../data/series";

export async function getStaticPaths() {
  return Object.keys(SERIES).map((slug) => ({
    params: { series: slug },
  }));
}

const { series } = Astro.params;
const meta = getSeriesMeta(series);
if (!meta) {
  throw new Error(`Series '${series}' not found in registry`);
}

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const seriesPosts = allPosts
  .filter((p) => p.data.series === series)
  .sort((a, b) => {
    // Ordina per seriesOrder se presente, altrimenti per pubDate
    const aOrder = a.data.seriesOrder ?? 999;
    const bOrder = b.data.seriesOrder ?? 999;
    if (aOrder !== bOrder) return aOrder - bOrder;
    return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
  });

const fmt = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "short",
  year: "numeric",
});

const verdictMap = {
  vince: { label: "Vince", color: "emerald" },
  parziale: { label: "Parziale", color: "amber" },
  "non-vince": { label: "Non vince", color: "rose" },
} as const;
---
<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <section class="mb-12">
    <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-blue-900/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-blue-900 dark:bg-blue-400/10 dark:text-blue-400">
      Serie
    </div>
    <h1 class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-5xl">
      {meta.title}
    </h1>
    <p class="mt-4 max-w-3xl text-base text-slate-600 dark:text-slate-300">
      {meta.description}
    </p>
  </section>

  <section aria-labelledby="series-posts">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 id="series-posts" class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Articoli della serie
      </h2>
      <span class="text-xs text-slate-400 dark:text-slate-500">
        {seriesPosts.length} {seriesPosts.length === 1 ? "articolo" : "articoli"}
      </span>
    </div>

    {seriesPosts.length === 0 ? (
      <p class="text-slate-500 dark:text-slate-400">
        Nessun articolo della serie ancora pubblicato. Stay tuned.
      </p>
    ) : (
      <ul class="divide-y divide-slate-200 dark:divide-slate-800">
        {seriesPosts.map((post) => {
          const v = post.data.verdict ? verdictMap[post.data.verdict] : null;
          return (
            <li class="py-5">
              <a href={`/posts/${post.slug}`} class="group block">
                <div class="flex flex-wrap items-baseline gap-3 text-xs text-slate-500 dark:text-slate-400">
                  {post.data.seriesOrder && (
                    <span class="font-mono text-slate-400">
                      #{post.data.seriesOrder}
                    </span>
                  )}
                  <time datetime={post.data.pubDate.toISOString()}>
                    {fmt.format(post.data.pubDate)}
                  </time>
                  {v && (
                    <span
                      class:list={[
                        "rounded-md px-1.5 py-0.5 font-semibold uppercase tracking-wider",
                        v.color === "emerald" && "bg-emerald-100 text-emerald-900 dark:bg-emerald-400/10 dark:text-emerald-400",
                        v.color === "amber" && "bg-amber-100 text-amber-900 dark:bg-amber-400/10 dark:text-amber-400",
                        v.color === "rose" && "bg-rose-100 text-rose-900 dark:bg-rose-400/10 dark:text-rose-400",
                      ]}
                    >
                      {v.label}
                    </span>
                  )}
                </div>
                <h3 class="mt-1 text-xl font-medium text-slate-900 group-hover:text-blue-900 dark:text-slate-50 dark:group-hover:text-blue-400">
                  {post.data.title}
                </h3>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                  {post.data.description}
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>
