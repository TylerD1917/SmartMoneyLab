---
/**
 * Blocco "Iscriviti alla newsletter".
 * Carica l'embed MailerLite (in src/components/mailerlite-newsletter.html)
 * dentro un iframe isolato: i suoi CSS/JS non entrano in conflitto con il sito
 * ed è sicuro anche se il blocco compare in più punti.
 *
 * Props:
 *   height: altezza dell'iframe in px (default 680). Regolala se il form si
 *           taglia o avanza troppo spazio, in base a quanto è alto il tuo modulo.
 */
import embedHtml from "./mailerlite-newsletter.html?raw";
interface Props { height?: number; }
const { height = 560 } = Astro.props;
---
<section id="newsletter" class="not-prose my-8 flex justify-center px-4">
  <div class="w-full max-w-[420px] overflow-hidden rounded-2xl">
    <iframe
      class="ml-nl-iframe"
      srcdoc={embedHtml}
      title="Iscriviti alla newsletter di SmartMoneyLab"
      loading="lazy"
      scrolling="no"
      style={`display:block;width:100%;height:${height}px;border:0;background:transparent`}
    ></iframe>
  </div>
</section>
<script is:inline>
  (function () {
    document.querySelectorAll("iframe.ml-nl-iframe").forEach(function (f) {
      f.addEventListener("load", function () {
        var doc;
        try { doc = f.contentWindow.document; } catch (e) { return; }
        function fit() {
          try {
            var h = doc.body.scrollHeight;
            if (h > 50) f.style.height = h + "px";
          } catch (e) {}
        }
        fit(); setTimeout(fit, 400); setTimeout(fit, 1200);
        // Riadatta l'altezza quando il contenuto cambia (es. form -> messaggio "Grazie!")
        try {
          new ResizeObserver(fit).observe(doc.body);
        } catch (e) {
          setInterval(fit, 800);
        }
      });
    });
  })();
</script>
